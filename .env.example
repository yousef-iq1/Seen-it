# Public browser configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public base URL that hosts catalog.json and overviews.json.
NEXT_PUBLIC_DATA_BASE_URL=

